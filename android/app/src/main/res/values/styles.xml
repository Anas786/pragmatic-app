<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!-- Flat #0B0F14 board, no logo: the JS splash draws the logo itself. -->
    <style name="BaseSplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/splashBg</item>
        <item name="android:statusBarColor">@color/splashBg</item>
        <item name="android:navigationBarColor">@color/splashBg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="SplashTheme" parent="BaseSplashTheme" />
</resources>
